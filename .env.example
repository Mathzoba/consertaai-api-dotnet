# =====================================================================================
# MODELO de variáveis de ambiente. Copie para ".env" e TROQUE todos os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
# =====================================================================================

# --- JWT compartilhado com a API Java (mesmo segredo, issuer e audience) — mínimo 32 caracteres
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_ISSUER=consertaai
JWT_AUDIENCE=consertaai-app

# --- Oracle (container local gvenzl/oracle-free)
ORACLE_PASSWORD=troque-senha-sys
ORACLE_APP_USER=consertaai
ORACLE_APP_PASSWORD=troque-senha-app

# --- MongoDB (container local). Para o MongoDB Atlas, use MongoDbSettings__ConnectionString=mongodb+srv://...
MONGO_USER=consertaai
MONGO_PASSWORD=troque-senha-mongo

# --- RabbitMQ (container local)
RABBITMQ_USER=consertaai
RABBITMQ_PASSWORD=troque-senha-rabbit

# --- API Java (opcional): habilita o health check HTTP "api_java"
API_JAVA_URL=

# --- Emissor de token de testes (POST /auth/token-teste). Use false em produção.
HABILITAR_TOKEN_TESTE=true

# --- Portas no host (altere se alguma já estiver em uso)
API_PORTA=8080
ORACLE_PORTA=1521
MONGO_PORTA=27017
RABBITMQ_PORTA=5672
RABBITMQ_PAINEL_PORTA=15672
