{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "NENHUM segredo neste arquivo. Senhas, JWT_SECRET e connection strings vêm de variáveis de ambiente, dotnet user-secrets ou variáveis secretas da pipeline (veja .env.example).",

  "ConnectionStrings": {
    "ConsertaAi": ""
  },

  "BancoDados": {
    "Provedor": "Oracle",
    "InicializarAoIniciar": true,
    "TentativasConexao": 10,
    "SegundosEntreTentativas": 5
  },

  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "ConsertaAiDb",
    "CollectionAtividades": "atividades"
  },

  "Eventos": {
    "Modo": "Log"
  },

  "RabbitMq": {
    "Uri": "",
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "consertaai.eventos",
    "FilaApoios": "consertaai.apoios"
  },

  "ApiJava": {
    "BaseUrl": "",
    "HealthPath": "/actuator/health",
    "ValidarOcorrencias": false,
    "TimeoutSegundos": 5
  },

  "Jwt": {
    "Emissor": "consertaai",
    "Audiencia": "consertaai-app",
    "ExpiracaoMinutos": 60
  },

  "Auth": {
    "EmissorTokenTesteHabilitado": false
  },

  "RateLimit": {
    "EscritasPorJanela": 5,
    "RequisicoesGeraisPorJanela": 120,
    "JanelaSegundos": 60
  },

  "Idempotencia": {
    "ValidadeHoras": 24
  },

  "Moderacao": {
    "MaximoLinks": 1
  },

  "Cors": {
    "OrigensPermitidas": [ "*" ]
  },

  "Swagger": {
    "Habilitado": true
  },

  "Observabilidade": {
    "ExportarConsole": false,
    "LogArquivoHabilitado": true,
    "CaminhoLogArquivo": "logs/consertaai-.log"
  }
}
